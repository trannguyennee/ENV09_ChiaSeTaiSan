<mxfile host="app.diagrams.net"><diagram name="KienTruc"><mxGraphModel grid="0" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="tieude" value="MÔ HÌNH KIẾN TRÚC HỆ THỐNG ENV-09 (CLIENT - SERVER, NHIỀU TẦNG)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="0" width="700" height="40" as="geometry" /></mxCell><mxCell id="g1" value="Tầng trình bày (Client)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1020" height="130" as="geometry" /></mxCell><mxCell id="tb" value="&lt;b&gt;Trình duyệt web&lt;/b&gt;&lt;br&gt;Nhân viên, Thủ kho, Lãnh đạo, Quản trị viên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="280" height="70" as="geometry" /></mxCell><mxCell id="fe" value="&lt;b&gt;Ứng dụng React 18 (SPA)&lt;/b&gt; - Vite, Tailwind CSS, Recharts, lucide-react&lt;br&gt;Axios gắn Token đăng nhập (Bearer) vào mọi yêu cầu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;fontFamily=Helvetica;fillColor=#dae8fc;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="610" height="70" as="geometry" /></mxCell><mxCell id="g2" value="Tầng ứng dụng (Server) - Spring Boot 3.3.5, Java 21" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1020" height="290" as="geometry" /></mxCell><mxCell id="ic" value="&lt;b&gt;XacThucInterceptor&lt;/b&gt; - kiểm tr