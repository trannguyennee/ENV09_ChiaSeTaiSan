<mxfile host="app.diagrams.net"><diagram name="SoDoToChuc"><mxGraphModel grid="0" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="tieude" value="SƠ ĐỒ TỔ CHỨC HỆ THỐNG CHIA SẺ VÀ TÁI SỬ DỤNG TÀI SẢN NỘI BỘ" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="0" width="600" height="40" as="geometry" /></mxCell><mxCell id="bgh" value="&lt;b&gt;Ban Giám hiệu / Lãnh đạo đơn vị&lt;/b&gt;&lt;br&gt;Theo dõi báo cáo CAI, phê duyệt thanh lý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;fontFamily=Helvetica;fillColor=#dae8fc;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="60" width="300" height="70" as="geometry" /></mxCell><mxCell id="qttb" value="&lt;b&gt;Phòng Quản trị Thiết bị&lt;/b&gt;&lt;br&gt;(Thủ kho)&lt;br&gt;Kiểm nhận, xét duyệt, giao nhận, bảo dưỡng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;fontFamily=Helvetica;fillColor=#dae8fc;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="320" height="80" as="geometry" /></mxCell><mxCell id="qtht" value="&lt;b&gt;Bộ phận Quản trị hệ thống&lt;/b&gt;&lt;br&gt;(Quản trị viên)&lt;br&gt;Danh mục, tài khoản, tham số CAI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;fontFamily=Helvetica;fillColor=#dae8fc;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="200" width="320" height="80" as="geometry" /></mxCell><mxCell id="khoa" value="&lt;b&gt;Các Khoa / Phòng / Viện&lt;/b&gt;&lt;br&gt;(Nhân viên, đại diện phòng ban)&lt;br&gt;Khai báo tài sản nhàn rỗi, đặt mượn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;fontFamily=Helvetica;fillColor=#dae8fc;fontStyle=1;" vertex="1" pa